        "class Human:\n",
        "    def __init__(self):\n",
        "        self.name = \"\"\n",
        "        self.age = 0\n",
        "    def printinfo(self,x,y):\n",
        "         # 属性を定義する\n",
        "         self.name = x\n",
        "         self.age = y\n",
        "         print(self.name,self.age)\n",
        "\n",
        "Tanaka = Human()\n",
        "# 属性にアクセスし、値を出力する\n",
        "Tanaka.printinfo(\"tanaka\",19)"
      ]
    }
  ]
